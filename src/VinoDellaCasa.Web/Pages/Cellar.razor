@page "/cellar"
@using VinoDellaCasa.Application.Services
@using VinoDellaCasa.Domain
@using VinoDellaCasa.Domain.Entities
@using VinoDellaCasa.Domain.Enums
@using VinoDellaCasa.Domain.Maturity
@using VinoDellaCasa.Domain.Filtering
@using VinoDellaCasa.Domain.Seed
@using VinoDellaCasa.Domain.Suggestions
@using VinoDellaCasa.Web
@using VinoDellaCasa.Web.Components
@inject CellarService CellarSvc
@inject IJSRuntime Js

<PageTitle>Cave — Vino della casa</PageTitle>

<header class="cave-header">
    <div class="cave-header-titles">
        <h1>Cave</h1>
        <p class="muted cave-lede">Catalogue d’abord · fiches lettre · « j’en ai en cave ».</p>
    </div>
    <div class="cave-header-actions">
        <a class="btn cave-cta-tonight" href="drink-tonight">À boire ce soir</a>
        <button type="button"
                class="btn btn-secondary @(_affinerOpen ? "is-active" : null)"
                @onclick="ToggleAffiner"
                aria-expanded="@_affinerOpen"
                aria-controls="cave-affiner">
            Affiner
        </button>
    </div>
</header>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="flash @(_messageIsError ? "flash-error" : null)">@_message</p>
}

@if (_affinerOpen)
{
    <section id="cave-affiner" class="cave-affiner card" aria-label="Affiner le catalogue">
        <div class="cave-affiner-head">
            <h2 class="cave-section-title">Affiner</h2>
            <button type="button" class="btn-linkish" @onclick="ClearFilters">Réinitialiser</button>
        </div>
        <div class="cave-filter-row">
            <label class="cave-filter-search">
                <span class="sr-only">Rechercher</span>
                <input class="form-input"
                       type="search"
                       placeholder="Nom, producteur, appellation…"
                       @bind="_searchText"
                       @bind:event="oninput" />
            </label>
            <label>
                Couleur
                <select class="form-input" @bind="_filterColor">
                    <option value="">Toutes</option>
                    @foreach (Color c in Enum.GetValues<Color>())
                    {
                        <option value="@c">@UiLabels.Color(c)</option>
                    }
                </select>
            </label>
            <label>
                Maturité
                <select class="form-input" @bind="_filterReady">
                    <option value="">Toutes</option>
                    <option value="ready">Prêt</option>
                    <option value="wait">À attendre</option>
                </select>
            </label>
            <label>
                Possession
                <select class="form-input" @bind="_filterOwned">
                    <option value="">Toutes</option>
                    <option value="in">En cave</option>
                    <option value="out">Pas encore</option>
                </select>
            </label>
        </div>
        <FranceWineMap Selected="_selectedRegion"
                       SelectedChanged="OnRegionChanged"
                       Counts="_regionCounts"
                       ShowSuisse="_showSuisse"
                       TotalCount="_catalog.Count" />
        <p class="muted cave-affiner-hint">
            Astuce démo —
            <button type="button" class="btn-linkish" @onclick="LoadSeeds" disabled="@_busy">
                Remplir la cave (échantillon @_seedCount)
            </button>
        </p>
    </section>
}

@if (_editing is not null)
{
    <section class="card edit-form">
        <h2>@(_isNew ? "Ajouter une bouteille perso" : "Modifier")</h2>
        <EditForm Model="_editing" OnValidSubmit="SaveAsync">
            <div class="form-grid">
                <label>Nom *
                    <InputText class="form-input" @bind-Value="_editing.Name" />
                </label>
                <label>Producteur
                    <InputText class="form-input" @bind-Value="_editing.Producer" />
                </label>
                <SuggestionInput Label="Région" @bind-Value="_editing.Region" Suggestions="FieldSuggestions.Region" Placeholder="Pessac-Léognan…" />
                <SuggestionInput Label="Pays" @bind-Value="_editing.Country" Suggestions="FieldSuggestions.Country" Placeholder="France" />
                <label>Couleur
                    <InputSelect class="form-input" @bind-Value="_editing.Color">
                        @foreach (Color c in Enum.GetValues<Color>())
                        {
                            <option value="@c">@UiLabels.Color(c)</option>
                        }
                    </InputSelect>
                </label>
                <SuggestionInput Label="Cépage" @bind-Value="_editing.Varietal" Suggestions="FieldSuggestions.Varietal" Placeholder="Merlot…" />
                <label>Millésime
                    <InputNumber class="form-input" @bind-Value="_editing.Vintage" />
                </label>
                <label>Quantité
                    <InputNumber class="form-input" @bind-Value="_editing.Quantity" />
                </label>
                <label>Prix CHF
                    <InputNumber class="form-input" @bind-Value="_editing.PriceChf" />
                </label>
                <label>Casier
                    <InputText class="form-input" @bind-Value="_editing.Bin" />
                </label>
                <label>Statut
                    <InputSelect class="form-input" @bind-Value="_editing.Status">
                        @foreach (BottleStatus s in Enum.GetValues<BottleStatus>())
                        {
                            <option value="@s">@UiLabels.Status(s)</option>
                        }
                    </InputSelect>
                </label>
                <label class="span-2">Notes
                    <InputTextArea class="form-input" @bind-Value="_editing.Notes" rows="2" />
                </label>
            </div>
            <div class="toolbar">
                <button type="submit" class="btn" disabled="@_busy">Enregistrer</button>
                <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Annuler</button>
            </div>
        </EditForm>
    </section>
}

@if (_loading)
{
    <div class="skeleton-grid" aria-busy="true" aria-label="Chargement">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
    </div>
}
else
{
    @if (HasActiveFilters)
    {
        <p class="filter-hint muted">
            Filtres actifs
            — <button type="button" class="btn-linkish" @onclick="ClearFilters">Tout effacer</button>
        </p>
    }

    @if (VisibleCatalog.Count == 0)
    {
        <div class="empty-state empty-state--filter card">
            <h3>Aucune fiche ne correspond</h3>
            <p>Élargissez la recherche, changez de région, ou effacez les filtres.</p>
            <button type="button" class="btn btn-secondary" @onclick="ClearFilters">Effacer les filtres</button>
        </div>
    }
    else
    {
        <div class="catalog-lettre-grid" aria-label="Catalogue">
            @for (var i = 0; i < VisibleCatalog.Count; i++)
            {
                var entry = VisibleCatalog[i];
                var idx = i;
                var qty = QtyFor(entry);
                <CatalogFiche Entry="entry"
                              Quantity="qty"
                              AsOfYear="_asOfYear"
                              EnterIndex="idx"
                              Disabled="_busy"
                              QuantityChanged="q => OnQtyChangedAsync(entry, q)" />
            }
        </div>
    }

    <p class="catalog-add-cta">
        <button type="button" class="btn-linkish catalog-add-link" @onclick="NewBottle" disabled="@_busy">
            Ajouter une bouteille perso →
        </button>
    </p>

    @if (CustomBottles.Count > 0)
    {
        <section class="cave-grid-section" aria-label="Bouteilles perso">
            <h2 class="cave-section-title">Mes bouteilles perso <span class="cave-count">(@CustomBottles.Count)</span></h2>
            <div class="bottle-grid bottle-grid--cave">
                @foreach (var b in CustomBottles)
                {
                    <BottleCard Bottle="b"
                                AsOfYear="_asOfYear"
                                Variant="BottleCardVariant.Grid"
                                OnEdit="() => Edit(b)"
                                OnMarkDrunk="() => MarkDrunkAsync(b)"
                                OnDelete="() => DeleteAsync(b)"
                                ShowOpenActions="true" />
                }
            </div>
        </section>
    }
}

@code {
    private readonly int _seedCount = CatalogSeedData.Count;
    private readonly int _asOfYear = DateTimeOffset.Now.Year;

    private List<CatalogEntry> _catalog = new();
    private List<Bottle> _bottles = new();
    private Dictionary<Guid, int> _qtyById = new();
    private Dictionary<string, int> _qtyByNameVintage = new();

    private Bottle? _editing;
    private bool _isNew;
    private bool _busy;
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;
    private WineMapRegion? _selectedRegion;
    private Dictionary<WineMapRegion, int> _regionCounts = new();
    private bool _showSuisse;
    private bool _affinerOpen;
    private string _searchText = string.Empty;
    private string _filterColor = string.Empty;
    private string _filterReady = string.Empty;
    private string _filterOwned = string.Empty;

    private List<CatalogEntry> VisibleCatalog
    {
        get
        {
            Color? color = Enum.TryParse<Color>(_filterColor, out var c) ? c : null;
            bool? ready = _filterReady switch
            {
                "ready" => true,
                "wait" => false,
                _ => null
            };

            var q = CatalogEntryFilter.Apply(
                _catalog,
                text: _searchText,
                color: color,
                readyToDrink: ready);

            if (_selectedRegion is WineMapRegion region)
            {
                q = q.Where(e => WineMapRegions.Resolve(e.Appellation, e.Country) == region);
            }

            if (_filterOwned == "in")
            {
                q = q.Where(e => QtyFor(e) > 0);
            }
            else if (_filterOwned == "out")
            {
                q = q.Where(e => QtyFor(e) <= 0);
            }

            return q
                .OrderBy(e => e.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private List<Bottle> CustomBottles =>
        _bottles
            .Where(b => b.Status != BottleStatus.Finished && b.Quantity > 0)
            .Where(b => !_catalog.Any(e => e.Id == b.Id
                || (string.Equals(e.Name, b.Name, StringComparison.OrdinalIgnoreCase) && e.Vintage == b.Vintage)))
            .OrderBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText)
        || !string.IsNullOrWhiteSpace(_filterColor)
        || !string.IsNullOrWhiteSpace(_filterReady)
        || !string.IsNullOrWhiteSpace(_filterOwned)
        || _selectedRegion is not null;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private void ToggleAffiner() => _affinerOpen = !_affinerOpen;

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _filterColor = string.Empty;
        _filterReady = string.Empty;
        _filterOwned = string.Empty;
        _selectedRegion = null;
    }

    private Task OnRegionChanged(WineMapRegion? region)
    {
        _selectedRegion = region;
        return Task.CompletedTask;
    }

    private int QtyFor(CatalogEntry entry)
    {
        if (_qtyById.TryGetValue(entry.Id, out var q))
        {
            return q;
        }

        var key = NameVintageKey(entry.Name, entry.Vintage);
        return _qtyByNameVintage.GetValueOrDefault(key);
    }

    private static string NameVintageKey(string name, int? vintage) =>
        $"{name.Trim().ToLowerInvariant()}|{vintage?.ToString() ?? "nv"}";

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            _catalog = CatalogSeedData.CreateEntries(_asOfYear).ToList();
            foreach (var e in _catalog)
            {
                // Refresh maturity for current calendar year.
                var probe = CatalogSeedData.ToBottle(e, quantity: 1, asOfYear: _asOfYear);
                e.ReadyToDrink = probe.ReadyToDrink;
            }

            var all = await CellarSvc.GetAllAsync();
            foreach (var b in all)
            {
                MaturityRules.ApplyReadyToDrink(b, _asOfYear);
            }

            _bottles = all.ToList();
            RebuildQtyMaps();

            _regionCounts = _catalog
                .GroupBy(e => WineMapRegions.Resolve(e.Appellation, e.Country))
                .ToDictionary(g => g.Key, g => g.Count());
            _showSuisse = _regionCounts.GetValueOrDefault(WineMapRegion.Suisse) > 0;

            if (_selectedRegion is WineMapRegion.Suisse && !_showSuisse)
            {
                _selectedRegion = null;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void RebuildQtyMaps()
    {
        _qtyById = _bottles
            .Where(b => b.Status != BottleStatus.Finished && b.Quantity > 0)
            .GroupBy(b => b.Id)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Quantity));

        _qtyByNameVintage = _bottles
            .Where(b => b.Status != BottleStatus.Finished && b.Quantity > 0)
            .GroupBy(b => NameVintageKey(b.Name, b.Vintage))
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Quantity));
    }

    private void Flash(string message, bool error = false)
    {
        _message = message;
        _messageIsError = error;
    }

    private async Task OnQtyChangedAsync(CatalogEntry entry, int qty)
    {
        _busy = true;
        try
        {
            await CellarSvc.SetCatalogQuantityAsync(entry, qty, asOfYear: _asOfYear);
            // Optimistic local map + light reload of bottles only.
            var all = await CellarSvc.GetAllAsync();
            foreach (var b in all)
            {
                MaturityRules.ApplyReadyToDrink(b, _asOfYear);
            }

            _bottles = all.ToList();
            RebuildQtyMaps();
        }
        catch (Exception ex)
        {
            Flash($"Impossible de mettre à jour la cave : {ex.Message}", error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void NewBottle()
    {
        _isNew = true;
        _editing = new Bottle
        {
            Name = string.Empty,
            Color = Color.Red,
            Country = "France",
            Quantity = 1,
            Status = BottleStatus.InStock
        };
        _message = null;
    }

    private void Edit(Bottle b)
    {
        _isNew = false;
        _editing = Clone(b);
        _message = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _isNew = false;
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Name))
        {
            Flash("Le nom est obligatoire.", error: true);
            return;
        }

        _busy = true;
        try
        {
            if (_isNew || _editing.Id == Guid.Empty)
            {
                await CellarSvc.AddAsync(_editing, asOfYear: _asOfYear);
                Flash("Bouteille perso ajoutée.");
            }
            else
            {
                await CellarSvc.UpdateAsync(_editing, asOfYear: _asOfYear);
                Flash("Bouteille mise à jour.");
            }

            _editing = null;
            _isNew = false;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(Bottle b)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", $"Supprimer « {b.Name} » ? Cette action est définitive.");
        if (!ok)
        {
            return;
        }

        _busy = true;
        try
        {
            await CellarSvc.DeleteAsync(b.Id);
            Flash($"Supprimé : {b.Name}");
            if (_editing?.Id == b.Id)
            {
                CancelEdit();
            }

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MarkDrunkAsync(Bottle b)
    {
        _busy = true;
        try
        {
            var updated = Clone(b);
            updated.Quantity = Math.Max(0, updated.Quantity - 1);
            updated.Status = updated.Quantity == 0 ? BottleStatus.Finished : BottleStatus.Drinking;
            await CellarSvc.UpdateAsync(updated, asOfYear: _asOfYear);
            Flash(updated.Quantity == 0
                ? $"Marqué fini : {b.Name}"
                : $"Marqué bu : {b.Name} (reste {updated.Quantity})");
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadSeeds()
    {
        _busy = true;
        try
        {
            var n = await CellarSvc.EnsureM1SeedsAsync(asOfYear: 2026, forceReplace: _bottles.Count > 0);
            Flash(n == 0 ? "Échantillon déjà présent." : $"{n} bouteilles d’échantillon en cave.");
            _selectedRegion = null;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static Bottle Clone(Bottle b) => new()
    {
        Id = b.Id,
        Name = b.Name,
        Producer = b.Producer,
        Region = b.Region,
        Country = b.Country,
        Color = b.Color,
        Varietal = b.Varietal,
        Vintage = b.Vintage,
        Quantity = b.Quantity,
        PriceChf = b.PriceChf,
        PurchaseDate = b.PurchaseDate,
        Bin = b.Bin,
        Status = b.Status,
        Notes = b.Notes,
        ReadyToDrink = b.ReadyToDrink,
        CreatedAt = b.CreatedAt,
        UpdatedAt = b.UpdatedAt
    };
}

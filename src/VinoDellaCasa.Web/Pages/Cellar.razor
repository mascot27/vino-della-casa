@page "/cellar"
@using VinoDellaCasa.Application.Services
@using VinoDellaCasa.Domain
@using VinoDellaCasa.Domain.Entities
@using VinoDellaCasa.Domain.Enums
@using VinoDellaCasa.Domain.Maturity
@using VinoDellaCasa.Domain.Filtering
@using VinoDellaCasa.Domain.Suggestions
@using VinoDellaCasa.Web
@using VinoDellaCasa.Web.Components
@inject CellarService CellarSvc
@inject IJSRuntime Js

<PageTitle>Cave — Vino della casa</PageTitle>

<header class="cave-header">
    <div class="cave-header-titles">
        <h1>Cave</h1>
        <p class="muted cave-lede">Parcourir · découvrir · ouvrir ce soir.</p>
    </div>
    <div class="cave-header-actions">
        <a class="btn cave-cta-tonight" href="drink-tonight">À boire ce soir</a>
        <button type="button"
                class="btn btn-secondary @(_affinerOpen ? "is-active" : null)"
                @onclick="ToggleAffiner"
                aria-expanded="@_affinerOpen"
                aria-controls="cave-affiner">
            Affiner
        </button>
        <button type="button" class="btn-linkish cave-seed-link" @onclick="LoadSeeds" disabled="@_busy">
            Charger l’échantillon
        </button>
        <button type="button" class="btn-linkish" @onclick="NewBottle" disabled="@_busy">
            Ajouter
        </button>
        <label class="cave-manage-toggle">
            <input type="checkbox" @bind="_manageMode" />
            <span>Gérer</span>
        </label>
    </div>
</header>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="flash @(_messageIsError ? "flash-error" : null)">@_message</p>
}

@if (_affinerOpen)
{
    <section id="cave-affiner" class="cave-affiner card" aria-label="Affiner la cave">
        <div class="cave-affiner-head">
            <h2 class="cave-section-title">Affiner</h2>
            <button type="button" class="btn-linkish" @onclick="ClearFilters">Réinitialiser</button>
        </div>
        <div class="cave-filter-row">
            <label class="cave-filter-search">
                <span class="sr-only">Rechercher</span>
                <input class="form-input"
                       type="search"
                       placeholder="Nom, producteur, appellation…"
                       @bind="_searchText"
                       @bind:event="oninput" />
            </label>
            <label>
                Couleur
                <select class="form-input" @bind="_filterColor">
                    <option value="">Toutes</option>
                    @foreach (Color c in Enum.GetValues<Color>())
                    {
                        <option value="@c">@UiLabels.Color(c)</option>
                    }
                </select>
            </label>
            <label>
                Maturité
                <select class="form-input" @bind="_filterReady">
                    <option value="">Toutes</option>
                    <option value="ready">Prêt</option>
                    <option value="wait">À attendre</option>
                </select>
            </label>
            <label>
                Casier
                <input class="form-input"
                       type="text"
                       placeholder="A1…"
                       @bind="_filterBin"
                       @bind:event="oninput" />
            </label>
        </div>
        <FranceWineMap Selected="_selectedRegion"
                       SelectedChanged="OnRegionChanged"
                       Counts="_regionCounts"
                       ShowSuisse="_showSuisse"
                       TotalCount="_bottles.Count" />
    </section>
}

@if (_editing is not null)
{
    <section class="card edit-form">
        <h2>@(_isNew ? "Ajouter une bouteille" : "Modifier")</h2>
        <EditForm Model="_editing" OnValidSubmit="SaveAsync">
            <div class="form-grid">
                <label>Nom *
                    <InputText class="form-input" @bind-Value="_editing.Name" />
                </label>
                <label>Producteur
                    <InputText class="form-input" @bind-Value="_editing.Producer" />
                </label>
                <SuggestionInput Label="Région" @bind-Value="_editing.Region" Suggestions="FieldSuggestions.Region" Placeholder="Pessac-Léognan…" />
                <SuggestionInput Label="Pays" @bind-Value="_editing.Country" Suggestions="FieldSuggestions.Country" Placeholder="France" />
                <label>Couleur
                    <InputSelect class="form-input" @bind-Value="_editing.Color">
                        @foreach (Color c in Enum.GetValues<Color>())
                        {
                            <option value="@c">@UiLabels.Color(c)</option>
                        }
                    </InputSelect>
                </label>
                <SuggestionInput Label="Cépage" @bind-Value="_editing.Varietal" Suggestions="FieldSuggestions.Varietal" Placeholder="Merlot…" />
                <label>Millésime
                    <InputNumber class="form-input" @bind-Value="_editing.Vintage" />
                </label>
                <label>Quantité
                    <InputNumber class="form-input" @bind-Value="_editing.Quantity" />
                </label>
                <label>Prix CHF
                    <InputNumber class="form-input" @bind-Value="_editing.PriceChf" />
                </label>
                <label>Casier
                    <InputText class="form-input" @bind-Value="_editing.Bin" />
                </label>
                <label>Statut
                    <InputSelect class="form-input" @bind-Value="_editing.Status">
                        @foreach (BottleStatus s in Enum.GetValues<BottleStatus>())
                        {
                            <option value="@s">@UiLabels.Status(s)</option>
                        }
                    </InputSelect>
                </label>
                <label class="span-2">Notes
                    <InputTextArea class="form-input" @bind-Value="_editing.Notes" rows="2" />
                </label>
            </div>
            <div class="toolbar">
                <button type="submit" class="btn" disabled="@_busy">Enregistrer</button>
                <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Annuler</button>
            </div>
        </EditForm>
    </section>
}

@if (_loading)
{
    <div class="skeleton-grid" aria-busy="true" aria-label="Chargement">
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
        <div class="skeleton-card"></div>
    </div>
}
else if (_bottles.Count == 0)
{
    <div class="empty-state empty-state--prestige card">
        <div class="empty-state-visual" aria-hidden="true">
            <img class="bottle-silhouette" src="img/bottles/empty.svg" alt="" width="36" height="90" />
        </div>
        <h3>Cave vide</h3>
        <p>Ajoutez des bouteilles pour obtenir des suggestions, ou chargez l’échantillon démo (@SeedCount).</p>
        <div class="empty-actions">
            <button type="button" class="btn" @onclick="LoadSeeds" disabled="@_busy">Charger l’échantillon</button>
            <button type="button" class="btn btn-secondary" @onclick="NewBottle" disabled="@_busy">Ajouter une bouteille</button>
        </div>
    </div>
}
else
{
    @if (HasActiveFilters)
    {
        <p class="filter-hint muted">
            Filtres actifs
            — <button type="button" class="btn-linkish" @onclick="ClearFilters">Tout effacer</button>
        </p>
    }

    @if (VisibleBottles.Count == 0)
    {
        <div class="empty-state empty-state--filter card">
            <h3>Aucune bouteille ne correspond</h3>
            <p>Élargissez la recherche, changez de région, ou effacez les filtres.</p>
            <button type="button" class="btn btn-secondary" @onclick="ClearFilters">Effacer les filtres</button>
        </div>
    }
    else
    {
        <div class="cave-browse">
            @if (Featured is Bottle featured)
            {
                <section class="cave-hero" aria-label="Bouteille à l’honneur">
                    <p class="cave-kicker">Ce soir</p>
                    <BottleCard Bottle="featured"
                                AsOfYear="_asOfYear"
                                Variant="BottleCardVariant.Featured"
                                OnFeaturedCta="() => OpenFeaturedAsync(featured)"
                                OnSelect="() => Edit(featured)"
                                ShowOpenActions="_manageMode">
                        @if (_manageMode)
                        {
                            <button type="button" class="btn-tiny" @onclick="() => Edit(featured)">Modifier</button>
                            <button type="button" class="btn-tiny" @onclick="() => MarkDrunkAsync(featured)" disabled="@_busy">Marquer bu</button>
                        }
                    </BottleCard>
                </section>
            }

            @if (AlsoReady.Count > 0)
            {
                <section class="cave-rail-section" aria-label="Aussi prêtes">
                    <h2 class="cave-section-title">Aussi prêtes</h2>
                    <div class="cave-rail" role="list">
                        @for (var i = 0; i < AlsoReady.Count; i++)
                        {
                            var b = AlsoReady[i];
                            var idx = i;
                            <div class="cave-rail-item" role="listitem">
                                <BottleCard Bottle="b"
                                            AsOfYear="_asOfYear"
                                            Variant="BottleCardVariant.Rail"
                                            EnterIndex="idx"
                                            OnSelect="() => Edit(b)"
                                            ShowOpenActions="_manageMode">
                                    @if (_manageMode)
                                    {
                                        <button type="button" class="btn-tiny" @onclick="() => Edit(b)">Modifier</button>
                                        <button type="button" class="btn-tiny" @onclick="() => MarkDrunkAsync(b)" disabled="@_busy">Marquer bu</button>
                                    }
                                </BottleCard>
                            </div>
                        }
                    </div>
                </section>
            }

            <section class="cave-grid-section" aria-label="Le reste de la cave">
                <h2 class="cave-section-title">Le reste de la cave <span class="cave-count">(@RestOfCave.Count)</span></h2>
                @if (RestOfCave.Count == 0)
                {
                    <p class="muted">Tout est prêt — rien d’autre à ranger ici.</p>
                }
                else
                {
                    <div class="bottle-grid bottle-grid--cave">
                        @for (var i = 0; i < RestOfCave.Count; i++)
                        {
                            var b = RestOfCave[i];
                            var idx = i;
                            <BottleCard Bottle="b"
                                        AsOfYear="_asOfYear"
                                        Variant="BottleCardVariant.Grid"
                                        EnterIndex="idx"
                                        OnEdit="() => Edit(b)"
                                        OnMarkDrunk="() => MarkDrunkAsync(b)"
                                        OnDelete="() => DeleteAsync(b)"
                                        ShowOpenActions="_manageMode">
                                @if (_manageMode)
                                {
                                    <button type="button" class="btn-tiny" @onclick="() => Edit(b)">Modifier</button>
                                    <button type="button" class="btn-tiny" @onclick="() => MarkDrunkAsync(b)" disabled="@_busy">Marquer bu</button>
                                    <button type="button" class="btn-tiny danger" @onclick="() => DeleteAsync(b)" disabled="@_busy">Supprimer</button>
                                }
                            </BottleCard>
                        }
                    </div>
                }
            </section>
        </div>
    }
}

@code {
    private const int SeedCount = 53;

    private List<Bottle> _bottles = new();
    private Bottle? _editing;
    private bool _isNew;
    private bool _busy;
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;
    private readonly int _asOfYear = DateTimeOffset.Now.Year;
    private WineMapRegion? _selectedRegion;
    private Dictionary<WineMapRegion, int> _regionCounts = new();
    private bool _showSuisse;
    private bool _affinerOpen;
    private bool _manageMode;
    private string _searchText = string.Empty;
    private string _filterColor = string.Empty;
    private string _filterReady = string.Empty;
    private string _filterBin = string.Empty;

    private List<Bottle> VisibleBottles
    {
        get
        {
            Color? color = Enum.TryParse<Color>(_filterColor, out var c) ? c : null;
            bool? ready = _filterReady switch
            {
                "ready" => true,
                "wait" => false,
                _ => null
            };

            var q = CaveBottleFilter.Apply(
                _bottles,
                text: _searchText,
                color: color,
                readyToDrink: ready,
                bin: _filterBin);

            if (_selectedRegion is WineMapRegion region)
            {
                q = q.Where(b => WineMapRegions.Resolve(b) == region);
            }

            return q.ToList();
        }
    }

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchText)
        || !string.IsNullOrWhiteSpace(_filterColor)
        || !string.IsNullOrWhiteSpace(_filterReady)
        || !string.IsNullOrWhiteSpace(_filterBin)
        || _selectedRegion is not null;

    /// <summary>Oldest ReadyToDrink InStock — same rule as drink-tonight #1.</summary>
    private Bottle? Featured
    {
        get
        {
            return ReadyOrdered.FirstOrDefault();
        }
    }

    private IEnumerable<Bottle> ReadyOrdered =>
        VisibleBottles
            .Where(b => b.Status == BottleStatus.InStock && b.Quantity > 0 && b.ReadyToDrink)
            .OrderBy(b => b.Vintage ?? int.MaxValue)
            .ThenBy(b => b.Name, StringComparer.OrdinalIgnoreCase);

    private List<Bottle> AlsoReady
    {
        get
        {
            var featuredId = Featured?.Id;
            return ReadyOrdered
                .Where(b => featuredId is null || b.Id != featuredId)
                .ToList();
        }
    }

    private List<Bottle> RestOfCave
    {
        get
        {
            var excluded = new HashSet<Guid>();
            if (Featured is Bottle f)
            {
                excluded.Add(f.Id);
            }

            foreach (var b in AlsoReady)
            {
                excluded.Add(b.Id);
            }

            return VisibleBottles
                .Where(b => !excluded.Contains(b.Id))
                .OrderBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private void ToggleAffiner() => _affinerOpen = !_affinerOpen;

    private void ClearFilters()
    {
        _searchText = string.Empty;
        _filterColor = string.Empty;
        _filterReady = string.Empty;
        _filterBin = string.Empty;
        _selectedRegion = null;
    }

    private Task OnRegionChanged(WineMapRegion? region)
    {
        _selectedRegion = region;
        return Task.CompletedTask;
    }

    private async Task OpenFeaturedAsync(Bottle featured)
    {
        // Product CTA: open manage/edit for that bottle (no detail page yet).
        Edit(featured);
        await Task.CompletedTask;
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var all = await CellarSvc.GetAllAsync();
            foreach (var b in all)
            {
                MaturityRules.ApplyReadyToDrink(b, _asOfYear);
            }

            _bottles = all
                .Where(b => b.Status != BottleStatus.Finished && b.Quantity > 0)
                .OrderBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();

            _regionCounts = _bottles
                .GroupBy(WineMapRegions.Resolve)
                .ToDictionary(g => g.Key, g => g.Count());
            _showSuisse = _regionCounts.GetValueOrDefault(WineMapRegion.Suisse) > 0;

            if (_selectedRegion is WineMapRegion sel
                && sel == WineMapRegion.Suisse
                && !_showSuisse)
            {
                _selectedRegion = null;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void Flash(string message, bool error = false)
    {
        _message = message;
        _messageIsError = error;
    }

    private void NewBottle()
    {
        _isNew = true;
        _editing = new Bottle
        {
            Name = string.Empty,
            Color = Color.Red,
            Country = "France",
            Quantity = 1,
            Status = BottleStatus.InStock
        };
        _message = null;
    }

    private void Edit(Bottle b)
    {
        _isNew = false;
        _editing = Clone(b);
        _message = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _isNew = false;
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Name))
        {
            Flash("Le nom est obligatoire.", error: true);
            return;
        }

        _busy = true;
        try
        {
            if (_isNew || _editing.Id == Guid.Empty)
            {
                await CellarSvc.AddAsync(_editing, asOfYear: _asOfYear);
                Flash("Bouteille ajoutée.");
            }
            else
            {
                await CellarSvc.UpdateAsync(_editing, asOfYear: _asOfYear);
                Flash("Bouteille mise à jour.");
            }

            _editing = null;
            _isNew = false;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(Bottle b)
    {
        var ok = await Js.InvokeAsync<bool>("confirm", $"Supprimer « {b.Name} » ? Cette action est définitive.");
        if (!ok)
        {
            return;
        }

        _busy = true;
        try
        {
            await CellarSvc.DeleteAsync(b.Id);
            Flash($"Supprimé : {b.Name}");
            if (_editing?.Id == b.Id)
            {
                CancelEdit();
            }

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MarkDrunkAsync(Bottle b)
    {
        _busy = true;
        try
        {
            var updated = Clone(b);
            updated.Quantity = Math.Max(0, updated.Quantity - 1);
            updated.Status = updated.Quantity == 0 ? BottleStatus.Finished : BottleStatus.Drinking;
            await CellarSvc.UpdateAsync(updated, asOfYear: _asOfYear);
            Flash(updated.Quantity == 0
                ? $"Marqué fini : {b.Name}"
                : $"Marqué bu : {b.Name} (reste {updated.Quantity})");
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadSeeds()
    {
        _busy = true;
        try
        {
            var n = await CellarSvc.EnsureM1SeedsAsync(asOfYear: 2026, forceReplace: _bottles.Count > 0);
            Flash(n == 0 ? "Échantillon déjà présent." : $"{n} bouteilles d’échantillon chargées.");
            _selectedRegion = null;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static Bottle Clone(Bottle b) => new()
    {
        Id = b.Id,
        Name = b.Name,
        Producer = b.Producer,
        Region = b.Region,
        Country = b.Country,
        Color = b.Color,
        Varietal = b.Varietal,
        Vintage = b.Vintage,
        Quantity = b.Quantity,
        PriceChf = b.PriceChf,
        PurchaseDate = b.PurchaseDate,
        Bin = b.Bin,
        Status = b.Status,
        Notes = b.Notes,
        ReadyToDrink = b.ReadyToDrink,
        CreatedAt = b.CreatedAt,
        UpdatedAt = b.UpdatedAt
    };
}

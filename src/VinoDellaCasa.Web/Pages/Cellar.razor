@page "/cellar"
@using VinoDellaCasa.Application.Services
@using VinoDellaCasa.Domain.Entities
@using VinoDellaCasa.Domain.Enums
@using VinoDellaCasa.Domain.Maturity
@using VinoDellaCasa.Domain.Suggestions
@using VinoDellaCasa.Web
@using VinoDellaCasa.Web.Components
@inject CellarService CellarSvc

<PageTitle>Cave — Vino della casa</PageTitle>

<h1>Cave</h1>
<p class="muted">Inventaire local — ajoutez des bouteilles ou chargez un échantillon pour explorer.</p>

<div class="toolbar">
    <button type="button" class="btn" @onclick="LoadSeeds" disabled="@_busy">Charger l’échantillon</button>
    <button type="button" class="btn btn-secondary" @onclick="NewBottle" disabled="@_busy">Ajouter une bouteille</button>
    <a class="btn btn-link" href="drink-tonight">À boire ce soir →</a>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="flash @(_messageIsError ? "flash-error" : null)">@_message</p>
}

@if (_editing is not null)
{
    <section class="card edit-form">
        <h2>@(_isNew ? "Ajouter une bouteille" : "Modifier")</h2>
        <EditForm Model="_editing" OnValidSubmit="SaveAsync">
            <div class="form-grid">
                <label>Nom *
                    <InputText class="form-input" @bind-Value="_editing.Name" />
                </label>
                <label>Producteur
                    <InputText class="form-input" @bind-Value="_editing.Producer" />
                </label>
                <SuggestionInput Label="Région" @bind-Value="_editing.Region" Suggestions="FieldSuggestions.Region" Placeholder="Pessac-Léognan…" />
                <SuggestionInput Label="Pays" @bind-Value="_editing.Country" Suggestions="FieldSuggestions.Country" Placeholder="France" />
                <label>Couleur
                    <InputSelect class="form-input" @bind-Value="_editing.Color">
                        @foreach (Color c in Enum.GetValues<Color>())
                        {
                            <option value="@c">@UiLabels.Color(c)</option>
                        }
                    </InputSelect>
                </label>
                <SuggestionInput Label="Cépage" @bind-Value="_editing.Varietal" Suggestions="FieldSuggestions.Varietal" Placeholder="Merlot…" />
                <label>Millésime
                    <InputNumber class="form-input" @bind-Value="_editing.Vintage" />
                </label>
                <label>Quantité
                    <InputNumber class="form-input" @bind-Value="_editing.Quantity" />
                </label>
                <label>Prix CHF
                    <InputNumber class="form-input" @bind-Value="_editing.PriceChf" />
                </label>
                <label>Casier
                    <InputText class="form-input" @bind-Value="_editing.Bin" />
                </label>
                <label>Statut
                    <InputSelect class="form-input" @bind-Value="_editing.Status">
                        @foreach (BottleStatus s in Enum.GetValues<BottleStatus>())
                        {
                            <option value="@s">@UiLabels.Status(s)</option>
                        }
                    </InputSelect>
                </label>
                <label class="span-2">Notes
                    <InputTextArea class="form-input" @bind-Value="_editing.Notes" rows="2" />
                </label>
            </div>
            <div class="toolbar">
                <button type="submit" class="btn" disabled="@_busy">Enregistrer</button>
                <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Annuler</button>
            </div>
        </EditForm>
    </section>
}

<section class="card">
    <h2>Inventaire (@_bottles.Count)</h2>
    @if (_loading)
    {
        <div class="skeleton-grid" aria-busy="true" aria-label="Chargement">
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
        </div>
    }
    else if (_bottles.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-visual" aria-hidden="true">
                <img class="bottle-silhouette" src="img/bottles/empty.svg" alt="" width="36" height="90" />
            </div>
            <h3>Cave vide</h3>
            <p>Ajoutez des bouteilles pour obtenir des suggestions, ou chargez un échantillon Bordeaux (50).</p>
            <div class="empty-actions">
                <button type="button" class="btn" @onclick="LoadSeeds" disabled="@_busy">Charger l’échantillon</button>
                <button type="button" class="btn btn-secondary" @onclick="NewBottle" disabled="@_busy">Ajouter une bouteille</button>
            </div>
        </div>
    }
    else
    {
        <div class="bottle-grid">
            @for (var i = 0; i < _bottles.Count; i++)
            {
                var b = _bottles[i];
                var idx = i;
                <BottleCard Bottle="b" AsOfYear="_asOfYear" EnterIndex="idx" ShowPrice="true"
                            OnSelect="() => Edit(b)">
                    <button type="button" class="btn-tiny" @onclick="() => Edit(b)">Modifier</button>
                    <button type="button" class="btn-tiny" @onclick="() => MarkDrunkAsync(b)" disabled="@_busy">Marquer bu</button>
                    <button type="button" class="btn-tiny danger" @onclick="() => DeleteAsync(b)" disabled="@_busy">Supprimer</button>
                </BottleCard>
            }
        </div>
    }
</section>

@code {
    private List<Bottle> _bottles = new();
    private Bottle? _editing;
    private bool _isNew;
    private bool _busy;
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;
    private readonly int _asOfYear = DateTimeOffset.Now.Year;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        try
        {
            var all = await CellarSvc.GetAllAsync();
            foreach (var b in all)
            {
                MaturityRules.ApplyReadyToDrink(b, _asOfYear);
            }

            _bottles = all
                .Where(b => b.Status != BottleStatus.Finished)
                .OrderBy(b => b.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private void Flash(string message, bool error = false)
    {
        _message = message;
        _messageIsError = error;
    }

    private void NewBottle()
    {
        _isNew = true;
        _editing = new Bottle
        {
            Name = string.Empty,
            Color = Color.Red,
            Country = "France",
            Quantity = 1,
            Status = BottleStatus.InStock
        };
        _message = null;
    }

    private void Edit(Bottle b)
    {
        _isNew = false;
        _editing = Clone(b);
        _message = null;
    }

    private void CancelEdit()
    {
        _editing = null;
        _isNew = false;
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editing.Name))
        {
            Flash("Le nom est obligatoire.", error: true);
            return;
        }

        _busy = true;
        try
        {
            if (_isNew || _editing.Id == Guid.Empty)
            {
                await CellarSvc.AddAsync(_editing, asOfYear: _asOfYear);
                Flash("Bouteille ajoutée.");
            }
            else
            {
                await CellarSvc.UpdateAsync(_editing, asOfYear: _asOfYear);
                Flash("Bouteille mise à jour.");
            }

            _editing = null;
            _isNew = false;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(Bottle b)
    {
        _busy = true;
        try
        {
            await CellarSvc.DeleteAsync(b.Id);
            Flash($"Supprimé : {b.Name}");
            if (_editing?.Id == b.Id)
            {
                CancelEdit();
            }

            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MarkDrunkAsync(Bottle b)
    {
        _busy = true;
        try
        {
            var updated = Clone(b);
            updated.Quantity = Math.Max(0, updated.Quantity - 1);
            updated.Status = updated.Quantity == 0 ? BottleStatus.Finished : BottleStatus.Drinking;
            await CellarSvc.UpdateAsync(updated, asOfYear: _asOfYear);
            Flash(updated.Quantity == 0
                ? $"Marqué fini : {b.Name}"
                : $"Marqué bu : {b.Name} (reste {updated.Quantity})");
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadSeeds()
    {
        _busy = true;
        try
        {
            var n = await CellarSvc.EnsureM1SeedsAsync(asOfYear: 2026, forceReplace: _bottles.Count > 0);
            Flash(n == 0 ? "Échantillon déjà présent." : $"{n} bouteilles d’échantillon chargées.");
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static Bottle Clone(Bottle b) => new()
    {
        Id = b.Id,
        Name = b.Name,
        Producer = b.Producer,
        Region = b.Region,
        Country = b.Country,
        Color = b.Color,
        Varietal = b.Varietal,
        Vintage = b.Vintage,
        Quantity = b.Quantity,
        PriceChf = b.PriceChf,
        PurchaseDate = b.PurchaseDate,
        Bin = b.Bin,
        Status = b.Status,
        Notes = b.Notes,
        ReadyToDrink = b.ReadyToDrink,
        CreatedAt = b.CreatedAt,
        UpdatedAt = b.UpdatedAt
    };
}
